# Copy to .env.local for `npm run dev`. All variables are read by the Next.js
# server at runtime; none of them reaches the browser.

# Address of the Go API as seen from the Next.js server.
API_URL=http://localhost:8080

# Public address of the API used in the pixel snippet shown to the users
# (what e-mail recipients will load).
PIXEL_BASE_URL=http://localhost:8080

# The session cookie is Secure by default in production (HTTPS only; browsers
# also accept it on http://localhost). Set to false to serve the panel over
# plain HTTP on another host.
# COOKIE_SECURE=false
