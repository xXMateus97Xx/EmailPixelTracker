# Copy to .env and adjust. Variables already set in the environment take
# precedence over the .env file.

# Database driver: postgres | sqlserver | mysql | mongodb
DB_DRIVER=postgres
# Examples:
#   postgres:  "host=localhost user=postgres password=postgres dbname=email_pixel_tracker port=5432 sslmode=disable"
#   sqlserver: "sqlserver://sa:Password123@localhost:1433?database=email_pixel_tracker"
#   mysql:     "root:root@tcp(localhost:3306)/email_pixel_tracker?parseTime=true"  (parseTime=true is required)
#   mongodb:   "mongodb://localhost:27017"
DB_DSN="host=localhost user=postgres password=postgres dbname=email_pixel_tracker port=5432 sslmode=disable"
# Database name, used only by MongoDB.
DB_NAME=email_pixel_tracker

HTTP_ADDR=:8080
# Comma separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For
# (e.g. 10.0.0.0/8). Leave empty when the API is exposed directly; behind a
# proxy it is required, otherwise every view gets the proxy IP.
TRUSTED_PROXIES=

# Swagger UI and OpenAPI specification (<DOCS_PATH>/ and <DOCS_PATH>/openapi.yaml).
# Off unless DOCS_ENABLED=true.
DOCS_ENABLED=false
# Base path of the docs; empty serves them at the application root.
DOCS_PATH=/docs

# At least 32 bytes. Generate a random value for each environment.
JWT_SECRET="change-me-to-a-random-secret-of-at-least-32-bytes"
JWT_TTL=1h

# bcrypt cost for new password hashes (4 to 31). Each +1 doubles the hashing time.
BCRYPT_COST=12

# First SuperAdmin, created on startup if no user with this username exists.
# The username is used to log in: no spaces, case-insensitive.
SUPERADMIN_USERNAME=superadmin
# Display name; defaults to "Super Admin".
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_PASSWORD=change-me-please

# Logs: LOG_LEVEL is debug | info | warn | error (default info); LOG_FORMAT is
# json | text (default json). Pixel and health check requests are logged only
# at debug level.
LOG_LEVEL=info
LOG_FORMAT=json

# Prometheus metrics at http://<METRICS_ADDR>/metrics, on a port apart from
# the API. Empty disables them. Do not expose this port publicly.
METRICS_ADDR=:9464

# Tracing (OpenTelemetry). Enabled when an OTLP/HTTP endpoint is set, e.g.
# http://localhost:4318 for Jaeger. The other OTEL_* variables are honored
# (OTEL_SERVICE_NAME, OTEL_TRACES_SAMPLER, OTEL_EXPORTER_OTLP_HEADERS...).
OTEL_EXPORTER_OTLP_ENDPOINT=

# reCAPTCHA v3 on the login. Off unless RECAPTCHA_ENABLED=true; then both keys
# are required (create them at https://www.google.com/recaptcha/admin, type
# "Score based (v3)", with the domain of the admin panel). The site key is
# public: GET /api/auth/recaptcha hands it to the login page.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Lowest accepted score, from 0.0 (bot) to 1.0 (person). Default 0.5.
RECAPTCHA_MIN_SCORE=0.5
